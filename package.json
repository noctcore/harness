{
  "name": "@noctcore/harness-repo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "docs:dev": "bun run --filter '@noctcore/harness-docs' dev",
    "docs:build": "bun run --filter '@noctcore/harness-docs' docs:build",
    "typecheck": "bun run --filter './packages/*' check-types && tsc -p scripts",
    "test": "bun run --filter './packages/*' test",
    "test:coverage": "bun run --filter './packages/*' test:coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "bun scripts/check-package-shape.ts",
    "check:workflows": "bun scripts/check-workflows.ts",
    "audit": "bun scripts/audit.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "publint": "0.3.25",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
