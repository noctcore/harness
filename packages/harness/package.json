{
  "name": "@noctcore/harness",
  "version": "0.7.0",
  "type": "module",
  "sideEffects": false,
  "description": "Portable Structure-Lock runner and lint-meta engine, plus generic lint-meta rules and pinned-tool runners. Enforces a repo's checks in any CI, with no Nightcore install.",
  "license": "MIT",
  "homepage": "https://github.com/noctcore/harness/tree/main/packages/harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/harness.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/noctcore/harness/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harness": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rules": {
      "import": {
        "types": "./dist/rules.d.ts",
        "default": "./dist/rules.js"
      },
      "require": {
        "types": "./dist/rules.d.cts",
        "default": "./dist/rules.cjs"
      }
    },
    "./pinned-tools": {
      "import": {
        "types": "./dist/pinned-tools.d.ts",
        "default": "./dist/pinned-tools.js"
      },
      "require": {
        "types": "./dist/pinned-tools.d.cts",
        "default": "./dist/pinned-tools.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts src/rules.ts src/pinned-tools.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
