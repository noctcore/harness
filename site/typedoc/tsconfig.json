{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@noctcore/harness": ["../../packages/harness/src/index.ts"],
      "@noctcore/harness/rules": ["../../packages/harness/src/rules.ts"],
      "@noctcore/harness/pinned-tools": ["../../packages/harness/src/pinned-tools.ts"],
      "@noctcore/harness/ci": ["../../packages/harness/src/ci.ts"],
      "@noctcore/harness/web-budget": ["../../packages/harness/src/web-budget.ts"],
      "@noctcore/harness-mutation": ["../../packages/harness-mutation/src/index.ts"]
    }
  },
  "include": ["entries", "../../packages/harness/src", "../../packages/harness-mutation/src"],
  "exclude": [
    "../../packages/harness/src/**/*.test.ts",
    "../../packages/harness-mutation/src/**/*.test.ts"
  ]
}
